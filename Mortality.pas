	procedure initSurvivalAdult (p: pStructDemographicRegimeSettings);
	var
		age: agesUnion;
	begin
		for age := kMinAgeUnion to kMaxAgeUnion_women do
			p^.mortalityInfo.survivalAdult_women[age] := (p^.mortalityInfo.survival_women[age] + p^.mortalityInfo.survival_women[age + 1]) / 2.0;
		for age := kMinAgeUnion to kMaxAgeUnion_men do
			p^.mortalityInfo.survivalAdult_men[age] := (p^.mortalityInfo.survival_men[age] + p^.mortalityInfo.survival_men[age + 1]) / 2.0;
	end;

	procedure mortality_level (p: pStructDemographicRegimeSettings; e0_women, e0_men: double);
	begin
		calc_survival_women(e0_women, p^.mortalityInfo.survival_women);
		calc_survival_men(e0_men, p^.mortalityInfo.survival_men);
		initSurvivalAdult (p);
	end;

    function realAge (randomGenerator: TRandomNumberGenerator; age: double; midYear: boolean = true): double;
	var
		midYearValue: double = 0.5;
	begin
		if age < 0 then exit (age);
		if not midYear then midYearValue := 0;
		if isInteger (age) then
			result := age + randomGenerator.alea(0.0, 0.99999999) - midYearValue
		else
			result := age;
	end;

	function calc_ageDeath (randomGenerator: TRandomNumberGenerator;
