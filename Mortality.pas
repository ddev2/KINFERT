							survival: TabSurvival): double;
		var
			dummy: double;
			age: agesLife;
	begin
		age := ageInit;
		dummy := randomGenerator.alea0 * survival[age];
		while (age < kMaxAgeLife) and (dummy < survival[age + 1]) do begin
			Inc ( age );
		end;
		calc_ageDeath := age + randomGenerator.alea(0, 0.9999999999);
	end;

	function calc_ageDeath0_3years (randomGenerator: TRandomNumberGenerator; age: agesLife; survival: TabSurvival): double;
	var
		a, q0: double;
	begin
		if age = 0 then
		begin
		{For the first year, we apply the approximation of Coale and Demeny for the calculation of L0}
		{L0 = a.l0 + (1-a).l1}
		{with a=0.34 for q0 < 0.1}
		{and a=0.463+2.9375 for q0 >= 0.1}
		{a is the number of years lived in the age interval by the deceased of the interval}
		{The uniform approximation is based on the assumption that a is equal to 0.5}
		{This is corrected by multiplying the monthly value by the factor a / 0.5}
		{It would be better to look for another continuous formula, such as Bourgeois Pichat or Heligman/Pollard/Rodgers}
			q0 := 1 - survival[1] / survival[0];
			if q0 < 0.1 then
				a := 0.34
			else
				a := 0.463 + 2.9375 * q0;
			calc_ageDeath0_3years := ( 1.0 * max ( 1, round(randomGenerator.alea(0.500001, 12.499999 * 0.5 / a) * a / 0.5) ) ) / 12.0;
		end else
		begin
			calc_ageDeath0_3years := ( age * 12.0 + round(randomGenerator.alea(0.500001, 12.499999)) ) / 12.0;
		end;
	end;

	procedure logit_antilogit (alpha, beta: double; var v: double);
	begin
		if (v > 0.0) and (v < 1.0) then
		begin
			v := 0.5 * ln (v / (1.0 - v));
			v := alpha + beta * v;
			v := exp ( 2.0 * v ) / ( 1.0 + exp ( 2.0 * v ) );
		end;
	end;
		
	procedure calc_survival (lifeTable: lifeTableType; lifeTable_e0: lifeTable_e0Type; e0: double; var survival: array of double);
	var
		survival_ageGroup : array [lifeTable_ageGroups] of double;
		ind_min, ind_max: longint;
		e0_min, e0_max: double;
		ageGroup: longint;
		i: longint;
		ageAlive: agesLife;
	begin
	
		{find a survival table in the model life table by interpolation}
		if (e0 < lifeTable_e0_min) or (e0 > lifeTable_e0_max) then
			writeAndWait('e0 too low or too high');
		
		ind_max := numLifeTable;
		for i := 2 to numLifeTable do
			if lifeTable_e0 [i] >= e0 then begin
				ind_max := i;
				break;
			end;
		ind_min := ind_max - 1;
		e0_min := lifeTable_e0 [ind_min];
		e0_max := lifeTable_e0 [ind_max];
		
		if (e0_max > lifeTable_e0_max) then e0_max := lifeTable_e0_max;
		
		for ageGroup := low(lifeTable_ageGroups) to high (lifeTable_ageGroups) do begin
			survival_ageGroup[ageGroup] := lifeTable[ind_min, ageGroup] + (lifeTable[ind_max, ageGroup] - lifeTable[ind_min, ageGroup]) * (e0 - e0_min) / (e0_max - e0_min);
		end;
		
		{now convert from five years age group to simple age}
		survival[0] := survival_ageGroup[0];
		survival[1] := survival_ageGroup[1];
		for ageGroup := low(lifeTable_ageGroups) + 2 to high (lifeTable_ageGroups) do begin
			survival[(ageGroup-1)*5] := survival_ageGroup[ageGroup];
		end;
		for i := 2 to 4 do
		begin
			survival[i] := survival[1] * (5-i)/4 + survival[5] * (i-1)/4;
		end;
		for ageGroup := low(lifeTable_ageGroups) + 2 to high (lifeTable_ageGroups) - 1 do
			for i := 1 to 4 do
			begin
				survival[(ageGroup-1)*5+i] := survival[(ageGroup-1)*5] * (5-i)/5 + survival[(ageGroup)*5] * (i)/5;
			end;

		for ageAlive := 1 to kMaxAgeLife do
		begin
			survival[ageAlive] := survival[ageAlive] / survival[0];
		end;
		survival[0] := 1.0;
	end;
	
	procedure calc_survival_men (e0: double; var survival: array of double);
	begin
		calc_survival(lifeTable_men, lifeTable_e0_men, e0, survival);
	end;
	procedure calc_survival_women (e0: double; var survival: array of double);
	begin
		calc_survival(lifeTable_women, lifeTable_e0_women, e0, survival);
	end;

	function probSurvival (age: longint; gender: Sex; m: MortalitySettings): double;
	begin
		if (gender = man) then
			probSurvival := m.survival_men [age]
		else
			probSurvival := m.survival_women [age];
	end;

	function sexAtBirth (randomGenerator: TRandomNumberGenerator; p: pStructDemographicRegimeSettings; age: longint): Sex;
	var
		propWomen: double = 0.488; // default value that can be changed for each demographic regime
		pF, pH: double;
	begin
		propWomen := p^.dp[propWomenAtBirth].value;
		pF := 1;
		pH := 1;
		if (age > 0) then begin
			pF :=  probSurvival (age, woman, p^.mortalityInfo);
			pH :=  probSurvival (age, man, p^.mortalityInfo);
		end;
		propWomen := propWomen * pF / (propWomen * pF + (1 - propWomen) * pH);
		if (randomGenerator.alea0 <= propWomen) then
			sexAtBirth := woman
		else
			sexAtBirth := man;
	end;


end.
