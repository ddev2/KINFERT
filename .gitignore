# =============================================================
#  KinFert .gitignore  (Lazarus / Free Pascal project)
# =============================================================
# Goal: track only source + project definition files.
# Everything generated by the compiler/linker, every binary,
# and all machine-specific config is excluded.
# -------------------------------------------------------------

# --- Compiler / build output ---------------------------------
lib/
*.ppu
*.ppl
*.o
*.or
*.a
*.compiled
*.dbg

# --- Linker temporary files (numbered, regenerated each link)-
link*.res
linkfiles*.res
symbol_order*.fpc

# NOTE: kinfert.res (project resource) and kinfertres.lrs
# (an {$I}-included resource) are intentionally NOT ignored:
# they are needed to compile.

# --- Lazarus session / user state (not portable) -------------
*.lps

# --- Editor / OS junk ----------------------------------------
*.bbprojectd/
.DS_Store
**/.DS_Store
Thumbs.db
*.~*

# --- Local backups -------------------------------------------
backup/
*.bak
copy.zip

# --- Debug / trace output ------------------------------------
heapTrace.log

# --- Compiled binaries (distribute via GitHub Releases) ------
/KinFert
/KinFert.exe
/KinFert.app/

# --- Machine-specific config (absolute paths / email) --------
# The program's own state, not input: it writes these itself and a fresh
# installation has neither. Since 1 October 2026 they live in the per-user
# state folder of each system, outside this folder altogether. The two names
# below are where they were kept before that, next to the executable; the
# files are still read once, to carry the paths across, so they are still
# ignored here.
KinFert ConfigDir.cfg
KinFert OutputDir.cfg

# --- Reference papers -----------------------------------------
# Published articles kept locally for reference. They are other
# people's copyright and do not belong in the repository.
References/
references/
# --- Working folders kept out of the repository ---------------
_to_delete/
backup/

# --- Working folders, not part of the program -----------------
# Papers and annexes, run outputs, and audit notes. Remove a line
# here if one of them should be published after all.
JASS/
KINFERT_runs/
chatgpt/

# --- Release staging -----------------------------------------
# The packaged binaries for a GitHub release. Built from the
# tagged commit and attached there, never committed.
release/
